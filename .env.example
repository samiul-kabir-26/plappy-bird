# --- Server ---
PORT=3000
NODE_ENV=development
DATA_DIR=./data

# --- Admin panel (fixed credentials) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs admin + player session tokens. Use: openssl rand -hex 32
JWT_SECRET=replace-with-long-random-string

# --- Integration: host system reads events / leaderboard with this key (X-API-Key header) ---
INTEGRATION_API_KEY=replace-with-long-random-string

# --- Player identity: shared secret the host uses to HMAC-sign launch tokens ---
PLAYER_TOKEN_SECRET=replace-with-long-random-string
# Let players without a launch token play as guests with a nickname
ALLOW_GUESTS=true

# --- Embedding ---
# Comma-separated origins allowed to call /api from a browser
CORS_ORIGINS=
# Comma-separated origins allowed to <iframe> the game (empty = same origin only)
FRAME_ANCESTORS=

# --- Behind a reverse proxy / TLS ---
# Set to the number of proxy hops (e.g. 1) so rate limiting sees real client IPs
TRUST_PROXY=
# Defaults to true when NODE_ENV=production. Set false only for plain-http testing.
COOKIE_SECURE=
