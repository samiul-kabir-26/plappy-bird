{
  "name": "plappy-bird",
  "version": "1.0.0",
  "description": "Embeddable Flappy Bird game microservice with admin panel, event log and leaderboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"npm:css:watch\"",
    "css:watch": "tailwindcss -c tailwind.config.cjs -i src/tailwind.css -o public/css/app.css --watch",
    "build": "tailwindcss -c tailwind.config.cjs -i src/tailwind.css -o public/css/app.css --minify",
    "start": "node server/index.js",
    "test": "vitest run",
    "launch-url": "node scripts/launch-url.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "vitest": "^5.0.4"
  }
}
